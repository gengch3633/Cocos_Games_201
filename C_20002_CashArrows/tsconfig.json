{
  "compilerOptions": {
    "module": "commonjs",
    "lib": [ "es2015", "es2017", "dom" ],
    "target": "es5",
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "outDir": "temp/vscode-dist",
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "creator.d.ts",
    "assets/scripts/cocos-globals.d.ts",
    "assets/scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "library",
    "local",
    "temp",
    "build",
    "settings"
  ]
}
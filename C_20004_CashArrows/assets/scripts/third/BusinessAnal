import MiddleTrackManager from "./MiddleTrackManager";

export default class BusinessAnalyticsService {
    public static reportData(eventName: string, data: any, forceRedirect: boolean = false): void {
        console.log("BusinessAnalyticsService.reportData", eventName, data, forceRedirect);
        const params = data || {};
        let redirectType = params.redirect_type;
        if (redirectType !== null && redirectType !== undefined && redirectType !== "") {
            redirectType = Number(redirectType);
        }
        if (forceRedirect) {
            redirectType = 1;
            params.redirect_type = 1;
        }
        MiddleTrackManager.getInstance().track(eventName, params, redirectType);
    }

    public static onTrack(raw: string): void {
        let data = JSON.parse(raw);
        if (!data) {
            data = {};
        }
        let redirectType = data.traceArcadeRouteCypress;
        if (redirectType) {
            redirectType = Number(redirectType);
        }
        MiddleTrackManager.getInstance().track(data.enrollFeintProcessOak, data.ferryBulkTierAgate, redirectType);
    }

    public static trackAll(): void {
        MiddleTrackManager.getInstance().trackAll();
    }
}